# Public — safe to expose to browser (Vite inlines VITE_ vars). Required.
# If your hosting warns "Remove the public prefix to keep private" — this one IS meant to be public.
# Mark it as "Exposed to browser" / "Client" in your hosting dashboard (e.g. Vercel: expose, Netlify: client).
VITE_API_BASE_URL=http://localhost:8080

# DO NOT put secrets in VITE_ vars — they are baked into the JS bundle and visible in DevTools.
# For PROJECT X-API-Key auth, set at runtime instead:
#   localStorage.setItem('recall_api_key', 'your_key')
# Or inject via server proxy without VITE_ prefix.
