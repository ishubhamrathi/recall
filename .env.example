# Public — safe to expose to browser (Vite inlines VITE_ vars). Required.
# If your hosting warns "Remove the public prefix to keep private" — this one IS meant to be public.
# Mark it as "Exposed to browser" / "Client" in your hosting dashboard (e.g. Vercel: expose, Netlify: client).
VITE_API_BASE_URL=http://localhost:8080

# Google Sign-In (credential flow). Normally LEAVE BLANK.
# The client id is fetched at runtime from GET /api/auth/google/config — the same
# GOOGLE_CLIENT_ID the backend verifies tokens against — so the button appears exactly when
# the deployment has Google sign-in enabled, and disappears again if it is turned off.
# This variable is only a FALLBACK used when that endpoint cannot be reached, so set it to the
# same Web client id the backend uses; a different one fails the audience check with
# 400 "Invalid Google credential".
VITE_GOOGLE_CLIENT_ID=

# Two console settings the backend cannot do for you:
#   1. Add this site's exact origin to "Authorized JavaScript origins" (scheme + host + port, no
#      trailing slash, no path) — e.g. http://localhost:5173. No redirect URI is needed.
#   2. The client id must come from the SAME Google Cloud project as the backend's
#      GOOGLE_CLIENT_ID. The server validates the token audience against that one id, so a token
#      from a different project is rejected with 400 "Invalid Google credential".
#
# Never put a Google client secret in a VITE_ var — it is inlined into the bundle and readable by
# anyone. The credential flow does not use a secret at all: the backend verifies the ID token
# against Google's public JWKS.

# DO NOT put secrets in VITE_ vars — they are baked into the JS bundle and visible in DevTools.
# For PROJECT X-API-Key auth, set at runtime instead:
#   localStorage.setItem('recall_api_key', 'your_key')
# Or inject via server proxy without VITE_ prefix.
